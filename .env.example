# Railway sets PORT automatically — only set locally
PORT=3340
DBD_BASE_URL=https://datawarehouse.dbd.go.th
# false required to pass DBD WAF (Docker/Railway uses xvfb-run for headed mode)
DBD_HEADLESS=false
DBD_NAV_TIMEOUT_MS=30000
# Leave empty in Docker/Railway (Playwright image ships bundled Chromium)
DBD_BROWSER_CHANNEL=
DBD_DEBUG=false
DBD_BLOCK_ASSETS=true
